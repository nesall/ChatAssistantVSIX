{
  "_comment": "PhenixCode RAG minimal configuration",
  "_version": "1.0.0",
  "_docs": "https://github.com/nesall/embedder_cpp/wiki/configuration",
  "tokenizer": {
    "config_path": "./bge_tokenizer.json"
  },
  "embedding": {
    "current_api": "custom",
    "batch_size": 4,
    "timeout_ms": 30000,
    "retry_attempts": 3,
    "top_k": 5,
    "prepend_label_format": "[Source: {}]\n"
  },
  "generation": {
    "current_api": "custom",
    "timeout_ms": 120000,
    "max_chunks": 7,
    "max_full_sources": 2,
    "max_related_per_source": 3,
    "default_temperature": 0.1,
    "default_max_tokens": 2048,
    "default_max_tokens_name": "max_tokens",
    "prepend_label_format": "[Source: {}]\n",
    "excerpt": {
      "enabled": true,
      "min_chunks": 3,
      "max_chunks": 15,
      "threshold_ratio": 0.75
    },
    "enabled_providers": [
      "custom",
      "local-fim-gemma",
      "mistral-devstral-small",
      "mistral-codestral",
      "gemini-2.0-flash",
      "deepseek",
      "xai",
      "openai-4o-mini",
      "minimax-m2.1"
    ],
    "default_context_length": 64000
  },
  "database": {
    "sqlite_path": "$(SolutionDir)/.phenixcode/db_metadata.db",
    "index_path": "$(SolutionDir)/.phenixcode/db_embeddings.index",
    "vector_dim": 768,
    "max_elements": 100000,
    "distance_metric": "cosine",
    "_comment": "For distance_metric use either cosine (default) or l2"
  },
  "chunking": {
    "semantic": true,
    "nof_min_tokens": 50,
    "nof_max_tokens": 450,
    "overlap_percentage": 0.2
  },
  "source": {
    "_comment_project_id": "Leave empty to auto-generate from config path, or set a custom stable project_id",
    "project_id": "",
    "project_title": "Default Project Title",
    "project_description": "",
    "paths": [
      {
        "exclude": [],
        "extensions": [],
        "path": "$(SolutionDir)",
        "recursive": true,
        "type": "directory"
      }
    ],
    "default_extensions": [
      ".c",
      ".cpp",
      ".cxx",
      ".h",
      ".hpp",
      ".py",
      ".js",
      ".ts",
      ".java",
      ".rs",
      ".cs",
      ".xaml",
      ".php",
      ".jsp",
      ".md"
    ],
    "global_exclude": [
      "*/node_modules/*",
      "*.min.js",
      "*.log",
      "*/build/*",
      "*/.git/*",
      ".gitignore",
      "*/.github/*",
      "*/CVS/*",
      "*/debug/*",
      "*/release/*",
      "*/lib/*",
      "*/docker/*",
      "*/fonts/*",
      "*/images/*",
      "*/test/*",
      "*/tests/*",
      "*/example/*",
      "*/examples/*",
      "*/obj/*",
      "*/build_dbg/*",
      "*/build_rel/*",
      "*/bin/*",
      "*/dist/*",
      "*/3rdparty/*"
    ],
    "encoding": "utf-8",
    "max_file_size_mb": 10
  },
  "logging": {
    "log_to_console": true,
    "log_to_file": true,
    "logging_file": "$(SolutionDir)/.phenixcode/embedder.log",
    "diagnostics_file": "$(SolutionDir)/.phenixcode/embedder_d.log"
  }
}
