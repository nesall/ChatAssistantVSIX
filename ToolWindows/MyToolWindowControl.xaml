<UserControl x:Class="ChatAssistantVSIX.MyToolWindowControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
 xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
 toolkit:Themes.UseVsTheme="True"
 Background="{DynamicResource {x:Static vs:VsBrushes.WindowKey}}"
 Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="{x:Static toolkit:ToolkitResourceKeys.ThemeResourcesUri}"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static toolkit:ToolkitResourceKeys.TextBoxStyleKey}}"/>
   <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static toolkit:ToolkitResourceKeys.ComboBoxStyleKey}}"/>
   <Style TargetType="Button" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}"><Setter Property="Padding" Value="7,3"/></Style>
   <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ScrollViewerStyleKey}}"/>
   <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ScrollBarStyleKey}}"/>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="transcript" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="TranscriptScrolled">
   <Grid>
    <StackPanel x:Name="emptyState" Margin="6,18">
     <TextBlock Text="Ask about your solution" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="scopeLabel" Text="Open a solution to get started" Margin="0,8,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="Try: Explain how this project is organized." Margin="0,16,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="messageList"/>
   </Grid>
  </ScrollViewer>
  <Button x:Name="jumpButton" Grid.Row="0" Panel.ZIndex="1" Content="↓ Jump to latest" Visibility="Collapsed" Click="JumpClicked"
   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Padding="10,5"
   Background="{DynamicResource {x:Static vs:VsBrushes.ButtonFaceKey}}" Foreground="{DynamicResource {x:Static vs:VsBrushes.ButtonTextKey}}"
   BorderBrush="{DynamicResource {x:Static platform:EnvironmentColors.ControlOutlineBrushKey}}" BorderThickness="1"
   ToolTip="Scroll to the latest message and follow new responses" AutomationProperties.Name="Jump to latest"/>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static vs:VsBrushes.CommandBarBorderKey}}" Padding="8">
   <StackPanel>
    <Border x:Name="composer" CornerRadius="5" BorderThickness="1" Padding="6" Background="{DynamicResource {x:Static platform:EnvironmentColors.ComboBoxBackgroundBrushKey}}">
     <Border.Style>
      <Style TargetType="Border">
       <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platform:EnvironmentColors.ControlOutlineBrushKey}}"/>
       <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.AccentMediumKey}}"/></Trigger></Style.Triggers>
      </Style>
     </Border.Style>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
       <TextBox x:Name="inputBox" MinHeight="44" MaxHeight="140" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource {x:Static platform:EnvironmentColors.ComboBoxTextBrushKey}}" CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="3" TextChanged="InputChanged" PreviewKeyDown="InputKeyDown" AutomationProperties.Name="Message" ToolTip="Enter to send · Shift+Enter for newline"/>
       <TextBlock x:Name="placeholder" Text="Ask about this solution…" IsHitTestVisible="False" Margin="4" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,5,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MaxWidth="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="providerBox" Height="24" MinHeight="0" MinWidth="0" FontSize="11" Padding="3,1" BorderThickness="0" MaxDropDownHeight="260" DropDownOpened="ProviderOpened" SelectionChanged="ProviderChanged" IsEnabled="False" AutomationProperties.Name="Chat model">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <Button x:Name="sendButton" Grid.Column="2" Content="Send" MinWidth="54" Margin="8,0,0,0" Click="SendClicked" ToolTip="Send message (Enter)"/>
      </Grid>
     </Grid>
    </Border>
    <TextBlock x:Name="serviceStatus" Text="Checking service…" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="notice" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <WrapPanel>
     <Button x:Name="retryButton" Content="Retry response" Visibility="Collapsed" Click="RetryClicked" Margin="0,0,5,0"/>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
